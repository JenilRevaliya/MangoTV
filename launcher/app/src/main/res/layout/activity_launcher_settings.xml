<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/columns_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
        </LinearLayout>

        <TextView
            android:id="@+id/animationsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/advancedChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/advanced_effects_warning"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/followThemeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/follow_theme" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/follow_theme_hint"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/defaultHomeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/home_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/home_settings_help"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/tv_settings" />

        <!-- Mango TV Ecosystem Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="MANGO ECOSYSTEM"
            android:textColor="#FF007AFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/mangoShareChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:text="Mango Share: On" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="LocalSend-compatible local network file receiving. 0 cloud, instant transfer."
            android:textColor="#FFACB8C1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/mangoAirPlayChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="14dp"
            android:text="Mango AirPlay: On" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Cast photos, videos, and media from Apple iPhone, iPad, and Mac."
            android:textColor="#FFACB8C1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/mangoBudsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="14dp"
            android:text="Mango Buds: On" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Auto-detect AirPods lid opening nearby with Apple TV-grade battery HUD."
            android:textColor="#FFACB8C1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/mangoPlayChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="14dp"
            android:text="Mango Play: On" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Seamless media casting and playback handoff from phones and computers."
            android:textColor="#FFACB8C1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/mangoPromptsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="14dp"
            android:text="System Pop-ups: Enabled" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Master control for all interactive connectivity overlays and status pills."
            android:textColor="#FFACB8C1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/clearCooldownsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="14dp"
            android:text="Reset Device Cooldowns" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Clear 5-minute suppression cooldown for previously declined devices."
            android:textColor="#FFACB8C1"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
