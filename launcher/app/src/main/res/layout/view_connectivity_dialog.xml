<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/connectivityOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="false"
    android:elevation="35dp"
    android:visibility="gone">

    <!-- Subtle Background Dimming Scrim -->
    <View
        android:id="@+id/connectivityScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="false" />

    <!-- Centered Translucent Glass Pop-up Card -->
    <LinearLayout
        android:id="@+id/connectivityCard"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_connectivity_card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="22dp"
        android:paddingBottom="24dp">

        <!-- Top Header: Badge, Title & Subtitle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/connectivityBadgeIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_badge_orange"
                android:padding="5dp"
                android:src="@drawable/ic_mango_play" />

            <TextView
                android:id="@+id/connectivityTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="Mango Buds"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/connectivitySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif"
            android:text="AirPods detected nearby"
            android:textColor="#FFA1A1A6"
            android:textSize="13sp" />

        <!-- Hairline Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="#1AFFFFFF" />

        <!-- ======================================================== -->
        <!-- Panel 1: Mango Buds (AirPods Illustration & Battery Info) -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/panelBuds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="visible">

            <ImageView
                android:id="@+id/budsCaseImage"
                android:layout_width="120dp"
                android:layout_height="72dp"
                android:contentDescription="AirPods Case"
                android:src="@drawable/ic_airpods_case_open" />

            <!-- Battery Row (Left, Right, Case) -->
            <LinearLayout
                android:id="@+id/budsBatteryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Left Earbud Battery Pill -->
                <LinearLayout
                    android:id="@+id/budsBatteryLeftPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_airpods_btn"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="9dp"
                        android:src="@drawable/ic_connectivity_battery" />

                    <TextView
                        android:id="@+id/budsBatteryLeftText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="92% Left"
                        android:textColor="#FFE5E5EA"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Right Earbud Battery Pill -->
                <LinearLayout
                    android:id="@+id/budsBatteryRightPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_airpods_btn"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="9dp"
                        android:src="@drawable/ic_connectivity_battery" />

                    <TextView
                        android:id="@+id/budsBatteryRightText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="88% Right"
                        android:textColor="#FFE5E5EA"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Case Battery Pill -->
                <LinearLayout
                    android:id="@+id/budsBatteryCasePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_airpods_btn"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="9dp"
                        android:src="@drawable/ic_connectivity_battery" />

                    <TextView
                        android:id="@+id/budsBatteryCaseText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="74% Case"
                        android:textColor="#FFE5E5EA"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/budsBatteryUnavailableText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:text="Battery information unavailable"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ======================================================== -->
        <!-- Panel 2: Mango Share (File Transfer Details & Progress)  -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/panelShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- File Preview Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/shareFileThumbnail"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_airpods_btn"
                    android:contentDescription="File Preview"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_picture" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/shareFileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:text="Weekend.jpg"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/shareFileMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif"
                        android:text="8.4 MB • Photo"
                        android:textColor="#FFA1A1A6"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Transfer Progress Section (During active transfer) -->
            <LinearLayout
                android:id="@+id/shareProgressSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/shareProgressBarReal"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_fill_bg" />

                <TextView
                    android:id="@+id/shareProgressStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="Receiving: 0 MB / 8.4 MB (0%)"
                    android:textColor="#FF007AFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======================================================== -->
        <!-- Panel 3: Mango Play (Media Artwork & Scrub Progress)     -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/panelPlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:id="@+id/playMediaThumbnail"
                    android:layout_width="88dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_airpods_btn"
                    android:contentDescription="Media Thumbnail"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_picture" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/playMediaTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:text="Interstellar"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/playMediaMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif"
                        android:text="2h 49m • 4K Video"
                        android:textColor="#FFA1A1A6"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Playback Progress Bar -->
            <ProgressBar
                android:id="@+id/playProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="14dp"
                android:max="1000"
                android:progress="420"
                android:progressDrawable="@drawable/progress_fill_bg" />

            <!-- Elapsed & Total Timestamps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playTimeElapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="1:12:06"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/playTimeTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="2:49:03"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======================================================== -->
        <!-- Panel 4: Mango Remote (Pairing PIN & Web Remote URL)     -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/panelRemote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 4-Digit PIN Container -->
            <LinearLayout
                android:id="@+id/remotePinContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/remotePinText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_airpods_btn"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.25"
                    android:paddingStart="24dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="10dp"
                    android:text="4 8 2 9"
                    android:textColor="#FFFFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Remote Web URL / Instructions -->
            <TextView
                android:id="@+id/remoteInstructionsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif"
                android:text="Open on your phone or scan to connect"
                android:textColor="#FFA1A1A6"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/remoteUrlText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="http://192.168.1.3:8090"
                android:textColor="#FFE5E5EA"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ======================================================== -->
        <!-- Shared Action Buttons Row (Unified Pill Focus Controls)  -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/connectivityButtonsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnConnectivityPrimary"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_connectivity_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/btnConnectivityPrimary"
                android:nextFocusRight="@+id/btnConnectivitySecondary"
                android:nextFocusUp="@+id/btnConnectivityPrimary"
                android:nextFocusDown="@+id/btnConnectivityPrimary"
                android:text="Connect"
                android:textColor="@color/color_btn_connectivity_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnConnectivitySecondary"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_connectivity_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/btnConnectivityPrimary"
                android:nextFocusRight="@+id/btnConnectivitySecondary"
                android:nextFocusUp="@+id/btnConnectivitySecondary"
                android:nextFocusDown="@+id/btnConnectivitySecondary"
                android:text="Decline"
                android:textColor="@color/color_btn_connectivity_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
