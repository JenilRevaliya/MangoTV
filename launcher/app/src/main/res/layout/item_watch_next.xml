<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="200dp"
        android:layout_height="112dp"
        android:background="@drawable/card_watch_bg"
        android:focusable="true"
        android:clickable="true"
        android:defaultFocusHighlightEnabled="false"
        android:clipToOutline="true">

        <!-- Cinematic episode still -->
        <ImageView
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- Subtle top vignette gradient for cinematic depth -->
        <View
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_card_top" />

        <!-- Ambient dark bottom vignette gradient for pristine typography contrast -->
        <View
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_card_bottom" />

        <!-- Show Title & Episode metadata stack -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="16dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:orientation="vertical">

            <!-- Title Row: Play triangle icon directly beside the Show Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/playIcon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/ic_play_triangle"
                    android:alpha="0.9"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/sf_bold"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Subheading: Season, Episode, Episode title -->
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#D9FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/sf_medium"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Remaining duration and App name right beside it -->
            <TextView
                android:id="@+id/duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:textColor="#A6FFFFFF"
                android:textSize="9sp"
                android:fontFamily="@font/sf_regular"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Progress Slider Bar with curved edges inside the box -->
        <FrameLayout
            android:id="@+id/progressTrack"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/progress_track_bg">

            <View
                android:id="@+id/progressFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/progress_fill_bg" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
