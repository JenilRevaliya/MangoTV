<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shareHud"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:layout_gravity="top|end"
    android:layout_marginTop="28dp"
    android:layout_marginEnd="36dp"
    android:background="@drawable/bg_airpods_card"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="25dp"
    android:orientation="vertical"
    android:padding="20dp"
    android:visibility="gone">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/shareHudIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Mango Share"
            android:src="@drawable/ic_mango_share" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shareHudTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Mango Share"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shareHudStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Incoming Transfer"
                android:textColor="#FF007AFF"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:id="@+id/shareStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/status_dot" />
    </LinearLayout>

    <!-- Hairline Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="#1AFFFFFF" />

    <!-- Transfer Details Text -->
    <TextView
        android:id="@+id/shareSenderDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="Sender • 1 file (0 MB)"
        android:textColor="#FFE5E5EA"
        android:textSize="14sp" />

    <!-- Progress Bar (Shown during transfer) -->
    <ProgressBar
        android:id="@+id/shareProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_fill_bg"
        android:visibility="gone" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:id="@+id/shareButtonsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnShareAccept"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_airpods_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/btnShareAccept"
            android:nextFocusRight="@+id/btnShareDecline"
            android:nextFocusDown="@+id/btnShareAccept"
            android:nextFocusUp="@+id/btnShareAccept"
            android:text="Accept"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnShareDecline"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_airpods_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/btnShareAccept"
            android:nextFocusRight="@+id/btnShareDecline"
            android:nextFocusDown="@+id/btnShareDecline"
            android:nextFocusUp="@+id/btnShareDecline"
            android:text="Decline"
            android:textColor="#FF8E8E93"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
