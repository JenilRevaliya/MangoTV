<?xml version="1.0" encoding="utf-8"?>
<!-- Apple-Style Aerial Screensaver (ClockDream): scenic wallpaper slideshow with smooth fade-in transitions and rule-of-thirds Apple typography -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Layer A wallpaper -->
    <ImageView
        android:id="@+id/wallpaperA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Layer B wallpaper for cross-fading -->
    <ImageView
        android:id="@+id/wallpaperB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null" />

    <!-- Subtle cinematic dark scrim for Apple-grade contrast and readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#38000000" />

    <!-- Rule of Thirds Content Block: positioned at the bottom-left third -->
    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="72dp"
        android:layout_marginBottom="56dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- Apple Greeting -->
        <TextView
            android:id="@+id/dreamGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GOOD EVENING"
            android:textColor="#D9FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/sf_bold"
            android:letterSpacing="0.10"
            android:textAllCaps="true"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6" />

        <!-- Massive, Thick iPhone Lockscreen Clock with shadow padding -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:id="@+id/dreamClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF"
                android:textSize="116sp"
                android:fontFamily="@font/sf_heavy"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="22" />

            <TextClock
                android:id="@+id/dreamAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="20dp"
                android:paddingEnd="12dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#B3FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/sf_bold"
                android:letterSpacing="0.04"
                android:textAllCaps="true"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8" />
        </LinearLayout>

        <!-- Day and Date -->
        <TextClock
            android:id="@+id/dreamDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:textColor="#E6FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/sf_bold"
            android:letterSpacing="0.04"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8" />

        <!-- Weather Block: Apple Liquid Glass Pill Container -->
        <LinearLayout
            android:id="@+id/dreamWeatherLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/weather_liquid_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dreamWeatherIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_weather_sun"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/dreamTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="30°"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:fontFamily="@font/sf_bold"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="|"
                android:textColor="#59FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/sf_regular"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/dreamWeatherDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear Sky"
                android:textColor="#D9FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/sf_medium"
                android:letterSpacing="0.02"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Apple TV Style Screensaver Branding: MangoTV Emblem (Top-Right Watermark) -->
    <ImageView
        android:id="@+id/dreamLogo"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="72dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_mangotv"
        android:contentDescription="MangoTV"
        android:alpha="0.80" />
</FrameLayout>
