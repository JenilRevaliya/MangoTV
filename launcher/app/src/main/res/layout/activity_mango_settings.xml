<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0E">

    <!-- Scrollable Content Hierarchy -->
    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="48dp"
        android:paddingTop="36dp"
        android:paddingEnd="48dp"
        android:paddingBottom="64dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Screen Title Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/settingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_bold"
                    android:letterSpacing="-0.02"
                    android:text="Settings"
                    android:textColor="#FFFFFFFF"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/badge_glass_bg"
                    android:fontFamily="@font/sf_medium"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="Mango TV"
                    android:textColor="#FFACB8C1"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- SECTION 1: Connectivity Overview (Side-by-side cards)     -->
            <!-- ======================================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <!-- Wi-Fi Card -->
                <LinearLayout
                    android:id="@+id/cardWifi"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_settings_overview_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusDown="@+id/cardMangoShare"
                    android:nextFocusRight="@+id/cardBluetooth"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_badge_orange"
                        android:padding="8dp"
                        android:src="@drawable/ic_wifi"
                        android:tint="#FFFFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sf_bold"
                            android:text="Wi-Fi"
                            android:textColor="#FFFFFFFF"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/textWifiStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/sf_medium"
                            android:singleLine="true"
                            android:text="Checking..."
                            android:textColor="#FFA1A1A6"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="#66FFFFFF" />
                </LinearLayout>

                <!-- Bluetooth Card -->
                <LinearLayout
                    android:id="@+id/cardBluetooth"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_settings_overview_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusDown="@+id/cardMangoShare"
                    android:nextFocusLeft="@+id/cardWifi"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_badge_blue"
                        android:padding="8dp"
                        android:src="@drawable/ic_bluetooth"
                        android:tint="#FFFFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sf_bold"
                            android:text="Bluetooth"
                            android:textColor="#FFFFFFFF"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/textBluetoothStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/sf_medium"
                            android:singleLine="true"
                            android:text="Checking..."
                            android:textColor="#FFA1A1A6"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="#66FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- SECTION 2: Mango Connectivity                             -->
            <!-- ======================================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/sf_bold"
                android:letterSpacing="0.04"
                android:text="MANGO CONNECTIVITY"
                android:textColor="#FF8E8E93"
                android:textSize="13sp" />

            <!-- Feature 1: Mango Share -->
            <LinearLayout
                android:id="@+id/cardMangoShare"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@+id/cardWifi"
                android:nextFocusDown="@+id/cardMangoPlay"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_orange"
                    android:padding="6dp"
                    android:src="@drawable/ic_mango_share"
                    android:tint="#FFFFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_medium"
                        android:text="Mango Share"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/textShareSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_regular"
                        android:text="Local high-speed file receiving (Port 8088)"
                        android:textColor="#FFA1A1A6"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textSharePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="@font/sf_medium"
                    android:text="Enabled"
                    android:textColor="#FF34C759"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switchMangoShare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:theme="@android:style/Theme.Material"
                    android:thumb="@drawable/bg_settings_toggle_thumb"
                    android:track="@drawable/bg_settings_toggle_track" />
            </LinearLayout>

            <!-- Feature 2: Mango Play & AirPlay -->
            <LinearLayout
                android:id="@+id/cardMangoPlay"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@+id/cardMangoShare"
                android:nextFocusDown="@+id/cardMangoBuds"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_blue"
                    android:padding="6dp"
                    android:src="@drawable/ic_mango_play"
                    android:tint="#FFFFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_medium"
                        android:text="Mango Play &amp; AirPlay"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/textPlaySub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_regular"
                        android:text="Casting, media handoff and AirPlay audio"
                        android:textColor="#FFA1A1A6"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textPlayPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="@font/sf_medium"
                    android:text="Enabled"
                    android:textColor="#FF34C759"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switchMangoPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:theme="@android:style/Theme.Material"
                    android:thumb="@drawable/bg_settings_toggle_thumb"
                    android:track="@drawable/bg_settings_toggle_track" />
            </LinearLayout>

            <!-- Feature 3: Mango Buds -->
            <LinearLayout
                android:id="@+id/cardMangoBuds"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@+id/cardMangoPlay"
                android:nextFocusDown="@+id/cardMangoRemote"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_orange"
                    android:padding="6dp"
                    android:src="@drawable/ic_airpods"
                    android:tint="#FFFFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_medium"
                        android:text="Mango Buds"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/textBudsSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_regular"
                        android:text="Nearby AirPods proximity BLE prompt and quick connect"
                        android:textColor="#FFA1A1A6"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textBudsPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="@font/sf_medium"
                    android:text="Enabled"
                    android:textColor="#FF34C759"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switchMangoBuds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:theme="@android:style/Theme.Material"
                    android:thumb="@drawable/bg_settings_toggle_thumb"
                    android:track="@drawable/bg_settings_toggle_track" />
            </LinearLayout>

            <!-- Feature 4: Mango Remote & QR Pairing -->
            <LinearLayout
                android:id="@+id/cardMangoRemote"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@+id/cardMangoBuds"
                android:nextFocusDown="@+id/btnCol4"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_orange"
                    android:padding="6dp"
                    android:src="@drawable/ic_remote"
                    android:tint="#FFFFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_medium"
                        android:text="Mango Remote &amp; Phone Pairing"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/textRemoteSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_regular"
                        android:text="Low-latency web remote (Port 8090) • Tap to Pair Phone via QR"
                        android:textColor="#FFA1A1A6"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textRemotePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="@font/sf_medium"
                    android:text="Pair Phone"
                    android:textColor="#FFFF9500"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switchMangoRemote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:theme="@android:style/Theme.Material"
                    android:thumb="@drawable/bg_settings_toggle_thumb"
                    android:track="@drawable/bg_settings_toggle_track" />
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- SECTION 3: Display & Appearance                           -->
            <!-- ======================================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/sf_bold"
                android:letterSpacing="0.04"
                android:text="DISPLAY &amp; APPEARANCE"
                android:textColor="#FF8E8E93"
                android:textSize="13sp" />

            <!-- App Grid Columns Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_settings_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_display"
                    android:tint="#FFA1A1A6" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/sf_medium"
                    android:text="Home Grid Columns"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnCol4"
                        style="@style/SettingsColumnChoice"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:nextFocusUp="@+id/cardMangoRemote"
                        android:nextFocusDown="@+id/cardAnimations"
                        android:nextFocusRight="@+id/btnCol5"
                        android:text="4"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnCol5"
                        style="@style/SettingsColumnChoice"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:nextFocusUp="@+id/cardMangoRemote"
                        android:nextFocusDown="@+id/cardAnimations"
                        android:nextFocusLeft="@+id/btnCol4"
                        android:nextFocusRight="@+id/btnCol6"
                        android:text="5"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnCol6"
                        style="@style/SettingsColumnChoice"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:nextFocusUp="@+id/cardMangoRemote"
                        android:nextFocusDown="@+id/cardAnimations"
                        android:nextFocusLeft="@+id/btnCol5"
                        android:nextFocusRight="@+id/btnCol7"
                        android:text="6"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnCol7"
                        style="@style/SettingsColumnChoice"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:nextFocusUp="@+id/cardMangoRemote"
                        android:nextFocusDown="@+id/cardAnimations"
                        android:nextFocusLeft="@+id/btnCol6"
                        android:text="7"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Animations Toggle Card -->
            <LinearLayout
                android:id="@+id/cardAnimations"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@+id/btnCol4"
                android:nextFocusDown="@+id/cardAdvancedEffects"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/sf_medium"
                    android:text="Smooth Focus Animations"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <Switch
                    android:id="@+id/switchAnimations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:theme="@android:style/Theme.Material"
                    android:thumb="@drawable/bg_settings_toggle_thumb"
                    android:track="@drawable/bg_settings_toggle_track" />
            </LinearLayout>

            <!-- Advanced Effects Card -->
            <LinearLayout
                android:id="@+id/cardAdvancedEffects"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@+id/cardAnimations"
                android:nextFocusDown="@+id/cardSoundSettings"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/sf_medium"
                    android:text="Advanced Glass &amp; Glow Effects"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <Switch
                    android:id="@+id/switchAdvancedEffects"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:theme="@android:style/Theme.Material"
                    android:thumb="@drawable/bg_settings_toggle_thumb"
                    android:track="@drawable/bg_settings_toggle_track" />
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- SECTION 4: Sound & Media                                  -->
            <!-- ======================================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/sf_bold"
                android:letterSpacing="0.04"
                android:text="SOUND &amp; MEDIA"
                android:textColor="#FF8E8E93"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/cardSoundSettings"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@+id/cardAdvancedEffects"
                android:nextFocusDown="@+id/cardClearCooldowns"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_volume"
                    android:tint="#FFA1A1A6" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_medium"
                        android:text="Audio Output &amp; System Volume"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_regular"
                        android:text="Adjust TV speaker and Bluetooth audio stream preferences"
                        android:textColor="#FFA1A1A6"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="#66FFFFFF" />
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- SECTION 5: Privacy & Security                             -->
            <!-- ======================================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/sf_bold"
                android:letterSpacing="0.04"
                android:text="PRIVACY &amp; SECURITY"
                android:textColor="#FF8E8E93"
                android:textSize="13sp" />

            <!-- Reset Cooldowns -->
            <LinearLayout
                android:id="@+id/cardClearCooldowns"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@+id/cardSoundSettings"
                android:nextFocusDown="@+id/cardRevokeRemotes"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_privacy"
                    android:tint="#FFA1A1A6" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_medium"
                        android:text="Reset Suppression Cooldowns"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_regular"
                        android:text="Clear 5-minute timeout for previously declined devices"
                        android:textColor="#FFA1A1A6"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_medium"
                    android:text="Reset"
                    android:textColor="#FFA1A1A6"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Revoke All Paired Phones -->
            <LinearLayout
                android:id="@+id/cardRevokeRemotes"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@+id/cardClearCooldowns"
                android:nextFocusDown="@+id/cardDeviceSettings"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock"
                    android:tint="#FFA1A1A6" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_medium"
                        android:text="Revoke All Paired Remotes"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_regular"
                        android:text="Invalidate all phone authentication tokens"
                        android:textColor="#FFA1A1A6"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_medium"
                    android:text="Revoke"
                    android:textColor="#FFFF453A"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- SECTION 6: Device Settings (Native Android Settings)     -->
            <!-- ======================================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/sf_bold"
                android:letterSpacing="0.04"
                android:text="SYSTEM &amp; DEVICE"
                android:textColor="#FF8E8E93"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/cardDeviceSettings"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@+id/cardRevokeRemotes"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_airpods_btn"
                    android:padding="6dp"
                    android:src="@drawable/ic_device_settings"
                    android:tint="#FFFFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_bold"
                        android:text="Device Settings"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_regular"
                        android:text="Wi-Fi, Bluetooth, display, sound and system settings"
                        android:textColor="#FFA1A1A6"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="#66FFFFFF" />
            </LinearLayout>

            <!-- System Information Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/badge_glass_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_bold"
                    android:text="System Diagnostics"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textSysInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/sf_regular"
                    android:lineSpacingExtra="3dp"
                    android:text="Mango TV v1.0 • Android 9 • Fire TV Stick 4K (AFTSS)\nStorage: 4.2 GB free • IP: 192.168.1.3"
                    android:textColor="#FF8E8E93"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ======================================================== -->
    <!-- DYNAMIC QR PAIRING DIALOG MODAL OVERLAY                  -->
    <!-- ======================================================== -->
    <FrameLayout
        android:id="@+id/qrDialogOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_settings_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="20dp"
            android:paddingEnd="28dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_bold"
                android:text="Pair Mango Remote"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/qrDialogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/sf_regular"
                android:text="Scan with iPhone Camera or Android Chrome"
                android:textColor="#FFA1A1A6"
                android:textSize="14sp" />

            <!-- Dynamic QR Code Container -->
            <FrameLayout
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_airpods_btn"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/qrImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <!-- Manual 4-Digit PIN Fallback -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/sf_medium"
                android:text="OR ENTER 4-DIGIT PIN ON PHONE"
                android:textColor="#FF8E8E93"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/qrPinText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/badge_glass_bg"
                android:fontFamily="@font/sf_bold"
                android:letterSpacing="0.25"
                android:paddingStart="20dp"
                android:paddingTop="6dp"
                android:paddingEnd="20dp"
                android:paddingBottom="6dp"
                android:text="5 4 3 2"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/qrUrlText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="http://192.168.1.3:8090"
                android:textColor="#FFFF9500"
                android:textSize="13sp" />

            <!-- Actions Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnQrRegenerate"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_settings_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/sf_medium"
                    android:gravity="center"
                    android:text="New PIN"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnQrDone"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_settings_btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/sf_bold"
                    android:gravity="center"
                    android:text="Done"
                    android:textColor="#FF000000"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</FrameLayout>
