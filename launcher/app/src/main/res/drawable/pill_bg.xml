<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Apple luminous bright white glass -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFFFFFFF"
                android:endColor="#F2FFFFFF" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Reorder / active mode: Apple blue glow -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#66007AFF"
                android:endColor="#33007AFF" />
            <stroke android:width="1.5dp" android:color="#FF0A84FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Normal: Apple translucent liquid glass with top highlight and subtle border -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#1AFFFFFF"
                android:endColor="#12FFFFFF" />
            <stroke android:width="1.2dp" android:color="#4DFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
