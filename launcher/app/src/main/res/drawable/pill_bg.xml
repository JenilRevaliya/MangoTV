<?xml version="1.0" encoding="utf-8"?>
<!-- Fluid Glass Top Bar Pill Button: Borderless multi-layer crystal liquid glass with specular meniscus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Luminous pure white glass highlight with subtle caustic drop shadow -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="#33000000" />
                </shape>
            </item>
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="21dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#FFFFFFFF"
                        android:centerColor="#F5FFFFFF"
                        android:endColor="#E6FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Reorder / Active Mode: Luminous Apple Accent Glow -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#66007AFF"
                android:endColor="#33007AFF" />
        </shape>
    </item>

    <!-- Normal: Clean borderless translucent crystal liquid glass with top specular highlight -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#38FFFFFF"
                        android:centerColor="#20FFFFFF"
                        android:endColor="#12FFFFFF" />
                </shape>
            </item>
            <item android:bottom="12dp" android:left="2dp" android:right="2dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="20dp"
                        android:topRightRadius="20dp"
                        android:bottomLeftRadius="4dp"
                        android:bottomRightRadius="4dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#59FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
