<?xml version="1.0" encoding="utf-8"?>
<!-- Fluid Glass Weather Dock Background: Borderless pure crystal liquid glass with specular meniscus -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#1CFFFFFF"
                android:endColor="#10FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="14dp"
        android:left="2dp"
        android:right="2dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#4DFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
