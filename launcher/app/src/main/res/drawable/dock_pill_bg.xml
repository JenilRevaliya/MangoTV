<?xml version="1.0" encoding="utf-8"?>
<!-- Pure Liquid Glass Dock Container: Borderless frosted glass capsule with specular meniscus sheen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 0: Ambient Caustic Drop Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>

    <!-- Layer 1: Frosted Blur Diffusion Base (Soft milky optical depth) -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>

    <!-- Layer 2: Frosted Liquid Glass Gradient Body (Seamless, no harsh stroke) -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <gradient
                android:angle="270"
                android:startColor="#4AFFFFFF"
                android:centerColor="#2EFFFFFF"
                android:endColor="#1CFFFFFF" />
        </shape>
    </item>

    <!-- Layer 3: Top Specular Meniscus (Curved Liquid Surface Reflection) -->
    <item
        android:bottom="26dp"
        android:left="2.5dp"
        android:right="2.5dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="25dp"
                android:topRightRadius="25dp"
                android:bottomLeftRadius="6dp"
                android:bottomRightRadius="6dp" />
            <gradient
                android:angle="270"
                android:startColor="#73FFFFFF"
                android:centerColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
