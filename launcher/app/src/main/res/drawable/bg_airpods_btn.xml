<?xml version="1.0" encoding="utf-8"?>
<!-- Fluid Glass Battery Pill: Borderless clean container with soft ambient shadow (Settings-like UI) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Minor Ambient Drop Shadow Layer (Offset down 1.5dp) -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>
    <!-- Translucent Surface Glass (NO BORDERS) -->
    <item
        android:bottom="1.5dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#10FFFFFF" />
        </shape>
    </item>
</layer-list>
