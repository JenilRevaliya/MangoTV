<?xml version="1.0" encoding="utf-8"?>
<!-- Fluid Glass Group Container: Borderless clean container with soft ambient shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Minor Ambient Drop Shadow Layer (Offset down 2dp) -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>
    <!-- Translucent Surface Glass (NO BORDERS) -->
    <item
        android:bottom="2dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#2EFFFFFF"
                android:centerColor="#1EFFFFFF"
                android:endColor="#12FFFFFF" />
        </shape>
    </item>
</layer-list>
