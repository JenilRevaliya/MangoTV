<?xml version="1.0" encoding="utf-8"?>
<!-- Fluid Glass Settings Card: Borderless clean glass with soft ambient shadow and focus illumination -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item
                android:bottom="0dp"
                android:left="0dp"
                android:right="0dp"
                android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#4D000000" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:left="0dp"
                android:right="0dp"
                android:top="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#FFFFFFFF"
                        android:centerColor="#FAFBFD"
                        android:endColor="#F2F4F7" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item
                android:bottom="0dp"
                android:left="0dp"
                android:right="0dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#33000000" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="0dp"
                android:right="0dp"
                android:top="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#3DFFFFFF"
                        android:endColor="#22FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:bottom="0dp"
                android:left="0dp"
                android:right="0dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#33000000" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="0dp"
                android:right="0dp"
                android:top="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#2EFFFFFF"
                        android:centerColor="#1EFFFFFF"
                        android:endColor="#12FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
