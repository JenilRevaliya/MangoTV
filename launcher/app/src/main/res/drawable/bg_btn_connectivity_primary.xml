<?xml version="1.0" encoding="utf-8"?>
<!-- Fluid Glass Connectivity Primary Action: Pure borderless glass with soft ambient shadow and luminous focus state -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused / Selected: Luminous White Button with Ambient Drop Shadow (NO BORDERS) -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Minor Ambient Drop Shadow Layer (Offset down 3dp) -->
            <item
                android:bottom="0dp"
                android:left="0dp"
                android:right="0dp"
                android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="#4D000000" />
                </shape>
            </item>
            <!-- Luminous Focused Surface -->
            <item
                android:bottom="3dp"
                android:left="0dp"
                android:right="0dp"
                android:top="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#FFFFFFFF"
                        android:centerColor="#FAFBFD"
                        android:endColor="#F2F4F7" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <layer-list>
            <item
                android:bottom="0dp"
                android:left="0dp"
                android:right="0dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="#4D000000" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="0dp"
                android:right="0dp"
                android:top="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#E6FFFFFF"
                        android:endColor="#D9FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal State: Translucent Glass with Minor Ambient Drop Shadow (NO BORDERS) -->
    <item>
        <layer-list>
            <item
                android:bottom="0dp"
                android:left="0dp"
                android:right="0dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="#33000000" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="0dp"
                android:right="0dp"
                android:top="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#F0FFFFFF"
                        android:centerColor="#E6FFFFFF"
                        android:endColor="#D9FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
