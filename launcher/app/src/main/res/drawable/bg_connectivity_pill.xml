<?xml version="1.0" encoding="utf-8"?>
<!-- Fluid Glass Pill: Borderless status indicator with specular meniscus -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#1A000000" />
        </shape>
    </item>

    <!-- Fluid Glass Body -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:centerColor="#1EFFFFFF"
                android:endColor="#10FFFFFF" />
        </shape>
    </item>

    <!-- Top Specular Meniscus Highlight -->
    <item
        android:bottom="14dp"
        android:left="2dp"
        android:right="2dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="21dp"
                android:topRightRadius="21dp"
                android:bottomLeftRadius="6dp"
                android:bottomRightRadius="6dp" />
            <gradient
                android:angle="270"
                android:startColor="#59FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
