<?xml version="1.0" encoding="utf-8"?>
<!-- Fluid Glass Primary Button: Borderless luminous white glass on focus, frosted translucent glass normally -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item
                android:bottom="0dp"
                android:left="0dp"
                android:right="0dp"
                android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="#4D000000" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:left="0dp"
                android:right="0dp"
                android:top="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#FFFFFFFF"
                        android:centerColor="#FAFBFD"
                        android:endColor="#F2F4F7" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:bottom="0dp"
                android:left="0dp"
                android:right="0dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="#4D000000" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="0dp"
                android:right="0dp"
                android:top="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#E6FFFFFF"
                        android:endColor="#D9FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:bottom="0dp"
                android:left="0dp"
                android:right="0dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="#33000000" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="0dp"
                android:right="0dp"
                android:top="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#2EFFFFFF"
                        android:centerColor="#1EFFFFFF"
                        android:endColor="#14FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
